{
    "name": "gotrasoft/whatsapp-api",
    "description": "Laravel package for WhatsApp Unofficial REST API integration",
    "keywords": ["laravel", "whatsapp", "api", "messaging"],
    "license": "MIT",
    "authors": [
        {
            "name": "Gung Cahyadi",
            "email": "gungcahyadipp@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Gotrasoft\\WhatsappApi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gotrasoft\\WhatsappApi\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Gotrasoft\\WhatsappApi\\WhatsappServiceProvider"
            ],
            "aliases": {
                "Whatsapp": "Gotrasoft\\WhatsappApi\\Facades\\Whatsapp"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
